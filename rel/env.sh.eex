#!/bin/sh
umask 077

# pass70 B7 (rel F7): no Erlang distribution. Nothing in swarmcode needs it. A
# fixed node name made a second swarmcode die with a raw Erlang error, and the
# distribution listener plus a world-readable cookie let any local user run
# code inside a session. Two swarmcode sessions now meet at the data lease,
# which refuses the second one with one sentence naming the first.
export RELEASE_DISTRIBUTION=none
