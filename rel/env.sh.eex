#!/bin/sh
umask 077

# pass70 B7 (rel F7): no Erlang distribution. Nothing in swarmcode needs it. A
# fixed node name made a second swarmcode die with a raw Erlang error, and the
# distribution listener plus a world-readable cookie let any local user run
# code inside a session. Two swarmcode sessions now meet at the data lease,
# which refuses the second one with one sentence naming the first.
export RELEASE_DISTRIBUTION=none

# pass70 F13: Ctrl-C in a cooked terminal (while the release boots, during
# `-p`, or after the full-screen view has printed its summary and the VM is
# still stopping) ends the process like any other command instead of opening
# the Erlang BREAK menu. The full-screen view reads Ctrl-C as a key in raw
# mode, so its Ctrl-C ladder is unchanged.
export ELIXIR_ERL_OPTIONS="+Bd${ELIXIR_ERL_OPTIONS:+ $ELIXIR_ERL_OPTIONS}"
