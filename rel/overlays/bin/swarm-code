#!/bin/sh
# Legacy name kept for old shims: everything is `swarmcode` now (pass70 B3).
# `swarm-code tui [ARGS]` and `swarm-code [ARGS]` both run `swarmcode [ARGS]`.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "${1:-}" = "tui" ]; then
  shift
fi
exec "$root/bin/swarmcode" "$@"
