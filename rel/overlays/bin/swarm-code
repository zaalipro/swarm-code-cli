#!/bin/sh
# Legacy name kept for old shims: the command is `ncode` now (it was
# `swarmcode` from pass70 B3). `swarm-code tui [ARGS]` and `swarm-code [ARGS]`
# both run `ncode [ARGS]`.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ "${1:-}" = "tui" ]; then
  shift
fi
exec "$root/bin/ncode" "$@"
