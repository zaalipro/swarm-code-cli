+  def await_reapers(timeout_ms) when is_integer(timeout_ms) do
+    deadline = System.monotonic_time(:millisecond) + max(timeout_ms, 0)
+    GenServer.call(__MODULE__, {:await, deadline}, :infinity)
+  catch
+    :exit, _no_server -> :ok
+  end
