+  # The first @cap graphemes of the file, equal to
+  # `String.slice(String.replace_invalid(text), 0, @cap)` without holding the file:
+  # raw chunks of at most 64 KiB, an incomplete trailing scalar carried to the
+  # next chunk, and the last grapheme withheld until a later chunk (or EOF)
+  # proves it complete.
+  defp read_prefix(full) do
+    case File.open(full, [:read, :binary, :raw]) do
+      {:ok, io} ->
+        try do
+          read_chunks(io, <<>>, [], 0, 0)
+        after
+          File.close(io)
+        end
+
+      {:error, reason} ->
+        "Error: #{:file.format_error(reason)}"
+    end
+  end
+
+  defp read_chunks(io, carry, acc, count, bytes) do
+    case :file.read(io, 65_536) do
+      {:ok, chunk} ->
+        bytes = bytes + byte_size(chunk)
+
+        if bytes > @max_read_bytes do
+          @too_large
+        else
+          {complete, incomplete} = split_incomplete(carry <> chunk)
+
+          [last | rest] =
+            complete |> String.replace_invalid() |> String.graphemes() |> prepend_none()
+
+          read_graphemes(io, last, rest, incomplete, acc, count, bytes)
+        end
+
+      :eof ->
+        finish(carry, acc, count)
+
+      {:error, reason} ->
+        "Error: #{:file.format_error(reason)}"
+    end
+  end
+
+  defp prepend_none([]), do: [nil]
+  defp prepend_none(graphemes), do: Enum.reverse(graphemes)
+
+  # `last`/`rest` arrive reversed: `last` is the final (unresolved) grapheme of
+  # this chunk, or nil when the chunk held no complete scalar yet.
+  defp read_graphemes(io, nil, _rest, incomplete, acc, count, bytes),
